{
	"schemaVersion": 1,
	"id": "areas-hint",
	"version": "${version}",
	"name": "Area Hints - 域名",
	"description": "一个可以在玩家进入区域时显示域名的模组 A mod that displays the domain name when a player enters an area",
	"authors": [
		"IMSng"
	],
	"contact": {
		"homepage": "https://imsng1019.github.io/",
		"sources": "https://github.com/IMSng1019/area-hints"
	},
	"license": "MIT",
	"icon": "assets/areas-hint/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"areahint.Areashint"
		],
		"client": [
			"areahint.AreashintClient"
		],
		"modmenu": [
			"areahint.modmenu.AreasHintModMenuApi"
		],
		"fabric-datagen": [
			"areahint.AreashintDataGenerator"
		]
	},
	"mixins": [
		"areas-hint.mixins.json",
		{
			"config": "areas-hint.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${fabricloader_version}",
		"minecraft": "${minecraft_range}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	},
	"suggests": {
		"sodium": "*",
		"modmenu": "*",
		"bluemap": "*",
		"xaerominimap": "=${xaero_minimap}",
		"xaeroworldmap": "=${xaero_world_map}",
		"vulkanmod": "*"
	},
	"recommends": {
		"luckperms": "*"
	}
}
